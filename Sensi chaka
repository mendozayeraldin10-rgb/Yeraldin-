local function crearBoton(nombre, posicion)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0.85,0,0,42)
    b.Position = UDim2.new(0.075,0,0,posicion)
    b.BackgroundColor3 = Color3.fromRGB(35,35,35)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = nombre .. " : OFF"
    b.TextSize = 16
    b.Parent = menu

    Instance.new("UICorner", b).CornerRadius =
        UDim.new(0,12)

    local activo = false

    b.MouseButton1Click:Connect(function()
        activo = not activo
        b.Text = nombre .. (activo and " : ON" or " : OFF")
        b.BackgroundColor3 = activo
            and Color3.fromRGB(120,0,0)
            or Color3.fromRGB(35,35,35)
    end)
end

crearBoton("AIMBOT CABEZA", 60)
crearBoton("ESP ENEMIGOS", 110)
crearBoton("SENSI HEADSHOT", 160)

-- ABRIR Y CERRAR
float.MouseButton1Click:Connect(function()
